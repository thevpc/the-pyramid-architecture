<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.thevpc.samples.petstore</groupId>
    <artifactId>petstore-root</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Pyramid PetStore :: Root</name>
    <description>Reference Implementation of The Pyramid Architecture</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.3.5</spring.boot.version>
        <nuts.version>1.0.0</nuts.version>
        <javaparser.version>3.26.4</javaparser.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <modules>
        <module>tools</module>
        <module>core</module>
        <module>extensions</module>
        <module>drivers</module>
        <module>modules</module>
        <module>apps</module>
        <module>tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Nuts Runtime -->
            <dependency>
                <groupId>net.thevpc.nuts</groupId>
                <artifactId>nuts</artifactId>
                <version>${nuts.version}</version>
            </dependency>

            <!-- JavaParser -->
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>

            <!-- ArchUnit -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Core Modules -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-dal-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-dal-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-service-rest-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>core-ws-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Extension: Notification -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>extension-notification-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>extension-notification-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>extension-notification-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>extension-notification-service-rest-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>extension-notification-ws-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Drivers: Notification -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-memory-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-memory-dal-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-memory-dal-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-memory-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-console-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>driver-notification-console-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Module: Catalog -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-dal-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-dal-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-service-rest-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>catalog-ws-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Module: Order -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-dal-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-dal-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-service-rest-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>order-ws-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Apps -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>app-petstore</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>app-catalog-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>app-order-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>app-notification-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Tools -->
            <dependency>
                <groupId>net.thevpc.samples.petstore</groupId>
                <artifactId>pyramid-generator</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
