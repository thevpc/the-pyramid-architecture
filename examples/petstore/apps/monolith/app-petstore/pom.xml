<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.thevpc.samples.petstore</groupId>
        <artifactId>petstore-apps-monolith</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>app-petstore</artifactId>
    <name>Pyramid PetStore :: Monolith App</name>

    <dependencies>
        <!-- Catalog Module Assembly -->
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>catalog-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>catalog-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>catalog-dal-jpa</artifactId>
        </dependency>

        <!-- Order Module Assembly -->
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>order-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>order-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>order-dal-jpa</artifactId>
        </dependency>

        <!-- Notification Extension Assembly -->
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>extension-notification-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>extension-notification-service-impl</artifactId>
        </dependency>

        <!-- Notification Drivers -->
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>driver-notification-memory-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>driver-notification-memory-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>driver-notification-console-service-impl</artifactId>
        </dependency>

        <!-- Core Assembly -->
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>core-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.thevpc.samples.petstore</groupId>
            <artifactId>core-dal-jpa</artifactId>
        </dependency>

        <!-- Infrastructure: Spring Web, JPA, H2, Nuts -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.thevpc.nuts</groupId>
            <artifactId>nuts</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
